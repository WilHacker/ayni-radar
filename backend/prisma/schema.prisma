generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoDesastre {
  INCENDIO
  INUNDACION
  DESLIZAMIENTO
  OTRO
}

enum EstadoZona {
  POR_VERIFICAR
  ACTIVA
  ATENDIDA
}

enum TipoDonacion {
  DINERO
  ROPA
  AGUA
  ALIMENTOS
  MEDICINA
}

enum EstadoDonacion {
  COMPROMETIDA
  VERIFICADA
  ENTREGADA
}

model Zona {
  id              String       @id @default(cuid())
  titulo          String
  departamento    String       @default("Santa Cruz")
  tipo            TipoDesastre
  latitud         Float
  longitud        Float
  estado          EstadoZona   @default(POR_VERIFICAR)
  severidad       Int          @default(1)
  metaBs          Float        @default(0) @map("meta_bs")
  recaudadoBs     Float        @default(0) @map("recaudado_bs")
  qrImagenUrl     String?      @map("qr_imagen_url")
  necesidadesJson Json         @default("{}") @map("necesidades_json")
  reportes        Reporte[]
  donaciones      Donacion[]
  creadoEn        DateTime     @default(now()) @map("creado_en")
  actualizadoEn   DateTime     @updatedAt @map("actualizado_en")

  @@index([tipo, estado])
  @@index([latitud, longitud])
  @@map("zonas")
}

model Reporte {
  id            String       @id @default(cuid())
  zonaId        String?      @map("zona_id")
  zona          Zona?        @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  tipo          TipoDesastre
  descripcion   String
  latitud       Float
  longitud      Float
  fotoUrl       String?      @map("foto_url")
  reportanteTag String?      @map("reportante_tag")
  creadoEn      DateTime     @default(now()) @map("creado_en")

  @@index([zonaId])
  @@index([creadoEn])
  @@map("reportes")
}

model Donacion {
  id                  String         @id @default(cuid())
  zonaId              String         @map("zona_id")
  zona                Zona           @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  nombreDonante       String         @map("nombre_donante")
  tipo                TipoDonacion
  montoBs             Float?         @map("monto_bs")
  cantidad            Int?
  detalleInsumo       String?        @map("detalle_insumo")
  comprobanteUrl      String?        @map("comprobante_url")
  evidenciaEntregaUrl String?        @map("evidencia_entrega_url")
  estado              EstadoDonacion @default(COMPROMETIDA)
  creadoEn            DateTime       @default(now()) @map("creado_en")
  actualizadoEn       DateTime       @updatedAt @map("actualizado_en")

  @@index([zonaId, estado])
  @@map("donaciones")
}
